{
  "assets": {
    "input_video": "obj_classification.mp4",
    "detection_model": "public/yolo11n",
    "classification_model": "pipeline-zoo-models/efficientnet-b0_INT8"
  },
  "pipelines": [
    {
      "name": "goods-detection-classification",
      "mode": "default",
      "pipeline": [
        "filesrc location=\"${video-path}\" ! decodebin3 !",
        "gvadetect model=\"${det-model-path}\"",
        "  model-instance-id=detect0",
        "  device=${detect_device} pre-process-backend=${detect_pre_process_backend}",
        "  batch-size=1 ${detect_ie_config} nireq=${detect_nireq}",
        "  threshold=0.5 inference-interval=3 scale-method=fast !",
        "queue !",
        "gvatrack tracking-type=zero-term-imageless !",
        "queue !",
        "gvaclassify model=\"${class-model-path}\"",
        "  model-instance-id=classify0",
        "  model-proc=\"${class-model-dir}/preproc-aspect-ratio.json\"",
        "  device=${classify_0_device} pre-process-backend=${classify_0_pre_process_backend}",
        "  batch-size=1 ${classify_0_ie_config} nireq=${classify_0_nireq}",
        "  labels=/opt/intel/dlstreamer/samples/labels/imagenet_2012.txt inference-region=roi-list reclassify-interval=1 !",
        "gvafpscounter starting-frame=100 !",
        "gvawatermark !",
        "gvametaconvert !",
        "queue !",
        "gvametapublish file-format=json-lines file-path=/dev/null !",
        "fakesink sync=false async=false"
      ]
    }
  ]
}
