{
  "assets": {
    "input_video": "age_prediction.mp4",
    "detection_model": "omz/face-detection-retail-0004",
    "classification_model": "omz/age-gender-recognition-retail-0013"
  },
  "pipelines": [
    {
      "name": "age-gender-recognition",
      "mode": "default",
      "pipeline": [
        "filesrc location=\"${video-path}\" ! decodebin3 !",
        "gvadetect model=\"${det-model-path}\"",
        "  model-instance-id=detect0",
        "  model-proc=\"${det-model-dir}/face-detection-retail-0004.json\"",
        "  device=${detect_device} pre-process-backend=${detect_pre_process_backend}",
        "  batch-size=1 ${detect_ie_config} nireq=${detect_nireq}",
        "  inference-interval=3 scale-method=fast inference-region=full-frame threshold=0.5 !",
        "queue !",
        "gvatrack tracking-type=zero-term-imageless !",
        "queue !",
        "gvaclassify model=\"${class-model-path}\"",
        "  model-instance-id=classify0",
        "  model-proc=\"${class-model-dir}/age-gender-recognition-retail-0013.json\"",
        "  device=${classify_0_device} pre-process-backend=${classify_0_pre_process_backend}",
        "  batch-size=1",
        "  inference-region=roi-list object-class=face reclassify-interval=1 !",
        "queue !",
        "gvafpscounter starting-frame=100 !",
        "gvawatermark !",
        "gvametaconvert !",
        "queue !",
        "gvametapublish file-format=json-lines file-path=/dev/null !",
        "fakesink sync=false async=false"
      ]
    }
  ]
}
